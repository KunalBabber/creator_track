NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Required for creator invitations, email changes, and account controls.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Configure this only on the server and in Apps Script Script Properties.
GOOGLE_FORMS_WEBHOOK_SECRET=replace-with-a-long-random-secret
